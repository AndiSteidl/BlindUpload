# Environment Settings for Gabis 50er Blind Upload App
PORT=8050
SECRET_KEY=super-secret-random-key-gabi-50
ADMIN_PASSWORD=Gabi50!
# Limits: 1GB per upload file (1073741824 bytes)
MAX_CONTENT_LENGTH=1073741824

# pCloud Cloud-Speicher Anbindung
# Wenn PCLOUD_ENABLED=true, landen Originale direkt in pCloud (0 MB lokaler Festplattenverbrauch).
PCLOUD_ENABLED=false
PCLOUD_REGION=EU
PCLOUD_FOLDER=/Gabis50

# OPTION 1 (EMPFOHLEN bei 2FA/MFA im Hauptkonto): OAuth2 Access Token
# Funktioniert direkt mit 2FA! Anleitung zur Token-Erstellung siehe README.md
PCLOUD_ACCESS_TOKEN=

# OPTION 2 (WebDAV - nur ohne 2FA, z. B. bei kostenlosem Zweitkonto):
PCLOUD_USERNAME=deine-email@beispiel.de
PCLOUD_PASSWORD=dein-passwort
